# Переменные окружения для Vercel (Project Settings -> Environment Variables)

# Токен Brawl Stars API (https://developer.brawlstars.com) — обязателен
BRAWL_API_TOKEN=

# Тег клуба по умолчанию (можно переопределять параметром ?tag= в запросах)
CLUB_TAG=#29QLUYOPO

# Разрешённые origin для CORS (через запятую). Для деплоя на одном домене
# с фронтендом можно оставить *, это безопасно, т.к. запросы идут с того же домена.
CORS_ORIGINS=*
